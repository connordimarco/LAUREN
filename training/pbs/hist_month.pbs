#PBS -N geodgp_hist
#PBS -l select=1:ncpus=40:model=cas_ait
#PBS -l walltime=48:00:00
#PBS -q long
#PBS -W group_list=s3007
#PBS -j oe
cd $PBS_O_WORKDIR
export SLURM_CPUS_PER_TASK=40
source env-nas/bin/activate
python hist_grid.py --year $YEAR --month $MONTH > logs/hist_${YEAR}_${MONTH}.log 2>&1
echo HIST $YEAR-$MONTH EXIT $? >> logs/hist_${YEAR}_${MONTH}.log
